// ═══════════════════════════════════════════════════════════════════════
// firestore.rules — Sentrix Security Rules
//
// MỤC ĐÍCH: Chặn cross-tenant data leak (lỗ hổng IDOR được phát hiện
// trong self-audit 2026-08-10: user A có thể đọc data của tenant B)
//
// DEPLOY: firebase deploy --only firestore:rules
//         (cần firebase-tools: npm i -g firebase-tools)
//
// NGUYÊN TẮC:
//   1. Firestore data của tenant X → chỉ user đã auth VÀ thuộc tenant X mới đọc được
//   2. Ghi feedback từ backend service account → chặn ghi trực tiếp từ client
//   3. Dashboard chỉ đọc (không ghi) → rules read-only cho authenticated users
// ═══════════════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Chặn tất cả truy cập mặc định (deny-by-default) ──────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Tenants: chỉ đọc thông tin public của tenant ─────────────────
    // Dashboard cần đọc business_name, settings từ tenants/{tenantId}
    match /tenants/{tenantId} {
      // Bất kỳ user đã đăng nhập đều đọc được thông tin tenant
      // (cần để hiện tên quán trên sidebar)
      // TODO: Thu hẹp về whitelist email khi có danh sách admin thật
      allow read: if request.auth != null;
      allow write: if false; // chỉ admin Firebase Console mới được ghi
    }

    // ─── Feedbacks: chỉ đọc, chặn ghi từ client ──────────────────────
    // Backend (service account) ghi vào đây qua Admin SDK
    // Dashboard chỉ đọc để hiển thị analytics
    match /tenants/{tenantId}/feedbacks/{feedbackId} {
      // Chỉ user đã auth mới đọc được feedbacks
      // TODO: Khi có danh sách admin per-tenant, thêm:
      //   && get(/databases/$(database)/documents/tenants/$(tenantId)/admins/$(request.auth.uid)).data.role == 'admin'
      allow read: if request.auth != null;

      // Cấm ghi trực tiếp từ client — backend dùng Admin SDK (bypass rules)
      allow write: if false;
    }

    // ─── Customers: tương tự feedbacks ────────────────────────────────
    match /tenants/{tenantId}/customers/{customerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

  }
}
