// ═══════════════════════════════════════════════════════════════════════
// firestore.rules — Sentrix Security Rules
//
// MỤC ĐÍCH: Chặn cross-tenant data leak (lỗ hổng IDOR)
// DEPLOY: firebase deploy --only firestore:rules
//
// NGUYÊN TẮC:
//   1. Firestore data của tenant X → chỉ đúng user mới đọc được
//   2. Ghi feedback: backend service account (Admin SDK, bypass rules)
//   3. Dashboard: read-only cho authenticated users
//   4. Web-client (unauthenticated): KHÔNG được phép ghi trực tiếp
//      vào bất kỳ document nào — mọi ghi dữ liệu phải qua Backend API
//
// SEC-01 FIX (2026-08-19):
//   Đã xóa rule `allow update` cho unauthenticated client trên feedbacks.
//   Trước đây rule này cho phép bất kỳ ai biết tenant_id + feedback_id
//   có thể ghi phone_masked và voucher_code giả mạo trực tiếp vào DB.
//   Giờ: mọi update phải qua Backend Admin SDK (bypass rules theo thiết kế Firestore).
// ═══════════════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Chặn tất cả truy cập mặc định (deny-by-default) ──────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Tenants: chỉ đọc thông tin public của tenant ─────────────────
    // Dashboard cần đọc business_name, settings từ tenants/{tenantId}
    match /tenants/{tenantId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Feedbacks: chỉ đọc cho auth user ─────────────────────────────
    // Ghi mới + update (phone, voucher, spin): chỉ qua Backend Admin SDK
    // SEC-01 FIX: Xóa rule allow update từ unauthenticated client.
    // SpinPage giờ gọi POST /api/v1/gamification/spin → backend dùng Admin SDK ghi.
    match /tenants/{tenantId}/feedbacks/{feedbackId} {
      // Dashboard (auth user) đọc được
      allow read: if request.auth != null;

      // Tất cả ghi (create/update/delete): chỉ Backend Admin SDK
      // Admin SDK bypass rules → không cần rule allow write ở đây
      allow write: if false;
    }

    // ─── Customers: chỉ đọc cho auth user ─────────────────────────────
    match /tenants/{tenantId}/customers/{customerId} {
      allow read: if request.auth != null;
      allow write: if false; // chỉ backend Admin SDK
    }

  }
}
