# Biến môi trường — WEB CLIENT
# Copy file này thành .env và điền giá trị thật

# URL backend của Tuyền
# Local dev: http://localhost:8000
# Production (sau khi Tuyền deploy lên Render): cập nhật URL thật vào đây
VITE_API_BASE_URL=http://localhost:8000

# === CÁC CỜ MOCK ===
# true = dùng mock data (Tuyền chưa code xong)
# false = gọi API thật (chỉ đổi khi Tuyền xác nhận endpoint đã sẵn sàng)

# Gamification /api/gamification/spin — CHƯA CÓ (xem docs/api-contract.md)
VITE_USE_MOCK_GAMIFICATION=true
