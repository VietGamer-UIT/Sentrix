# Biến môi trường — WEB CLIENT
# Copy file này thành .env và điền giá trị thật
# TUYỆT ĐỐI KHÔNG commit file .env lên GitHub!

# URL backend (Render production)
VITE_API_BASE_URL=https://sentrix-9dgc.onrender.com
# Khi dev local với backend Tuyền chạy tại máy:
# VITE_API_BASE_URL=http://localhost:8000

# === CÁC CỜ MOCK ===
# false = gọi API thật (backend đã deploy lên Render)
# true = mock frontend khi backend chưa sẵn sàng
VITE_USE_MOCK_GAMIFICATION=false

# === Firebase (lấy từ Firebase Console → Project settings) ===
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

