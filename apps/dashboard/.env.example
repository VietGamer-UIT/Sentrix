# Biến môi trường — DASHBOARD
# Copy file này thành .env và điền giá trị thật
# TUYỆT ĐỐI KHÔNG commit file .env lên GitHub!

# === Firebase (lấy từ Firebase Console → Project settings) ===
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Tenant demo dùng để dev local
VITE_DEMO_TENANT_ID=pho-ba-lan_1722500000000

# true = dữ liệu mẫu | false = Firestore thật
VITE_USE_MOCK_FIRESTORE=false

# Backend API URL (VoucherConfigPage gọi PUT để lưu config)
VITE_API_URL=https://sentrix-backend.onrender.com

# === Chi phí vận hành (OperatingCostPage) ===
# Đơn giá ước tính — chỉnh theo thực tế billing
VITE_COST_WHISPER_PER_CALL=0.0015    # USD/lượt (~15 giây x $0.006/phút)
VITE_COST_GEMINI_PER_CALL=0.0001     # USD/lượt (~400 token với Flash-Lite)
VITE_COST_ZNS_PER_MSG=400            # VNĐ/tin ZNS (tin nhắn gửi voucher CSKH)
VITE_COST_RENDER_MONTHLY_USD=0       # USD/tháng Render (free tier = 0)
VITE_COST_VERCEL_MONTHLY_USD=0       # USD/tháng Vercel (Hobby = 0)
VITE_USD_VND_RATE=25000              # 1 USD = 25,000 VNĐ
