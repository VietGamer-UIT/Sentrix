VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ID tenant demo để phát triển cục bộ (dùng mock data khi chưa có Firestore thật)
VITE_DEMO_TENANT_ID=pho-ba-lan_1722500000000

# true = dùng mock data Firestore (khi chưa có Firebase project thật)
# false = kết nối Firestore thật (khi Tuyền setup Firebase xong)
VITE_USE_MOCK_FIRESTORE=true
