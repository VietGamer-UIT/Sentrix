# Firebase Config
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_PRIVATE_KEY=your_private_key_here
FIREBASE_CLIENT_EMAIL=your_client_email_here
# Path đến file JSON credentials của Firebase Service Account (dùng bởi firebase-admin SDK)
# Ví dụ: backend/serviceAccountKey.json  — KHÔNG commit file này lên GitHub!
FIREBASE_CREDENTIALS={"type": "service_account", ...}

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.1-flash-lite

# AI APIs
WHISPER_API_KEY=your_whisper_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Zalo ZNS
ZALO_APP_ID=your_zalo_app_id_here
ZALO_ACCESS_TOKEN=your_zalo_access_token_here
ZALO_REFRESH_TOKEN=your_zalo_refresh_token_here
