# ══════════════════════════════════════════════════════════
# SENTRIX BACKEND — .env.example (Root repo)
# ══════════════════════════════════════════════════════════
# Copy thành .env và điền giá trị thật.
# TUYỆT ĐỐI KHÔNG commit .env lên GitHub!
# ══════════════════════════════════════════════════════════

# ── Firebase Admin SDK (backend Python) ──────────────────
# Cách 1 (local dev): đặt FIREBASE_CREDENTIALS_PATH trỏ đến file JSON
#   FIREBASE_CREDENTIALS_PATH=backend/serviceAccountKey.json
# Cách 2 (Render production): dùng 3 biến riêng lẻ bên dưới
FIREBASE_PROJECT_ID=sentrix-demo-164
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@sentrix-demo-164.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Lấy từ: Firebase Console → Project Settings → Service Accounts → Generate new private key

# ── OpenAI Whisper STT ────────────────────────────────────
# Tên biến: WHISPER_API_KEY (hoặc OPENAI_API_KEY — backend đọc cả hai)
WHISPER_API_KEY=sk-proj-...
# Lấy từ: https://platform.openai.com/api-keys

# ── Google Gemini ABSA ────────────────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
# Lấy từ: https://aistudio.google.com/app/apikey

# ── CORS (tùy chọn — override danh sách default) ──────────
# Mặc định đã có Vercel URLs trong main.py, không cần set nếu không có domain thêm
# ALLOWED_ORIGINS=https://your-extra-domain.vercel.app

# ── Zalo ZNS (chưa dùng trong MVP) ───────────────────────
# ZNS_ENABLED=false
# ZALO_APP_ID=
# ZALO_ACCESS_TOKEN=
# ZALO_REFRESH_TOKEN=

# ══════════════════════════════════════════════════════════
# MODULE 1: Anti-Fraud Pipeline
# ══════════════════════════════════════════════════════════

# ── OTP Provider ──────────────────────────────────────────
# Chọn "mock" (demo/dev) hoặc "zalo" (production với Zalo ZNS OTP)
OTP_PROVIDER=mock
# Code tĩnh cho mock provider (tiện cho demo — bỏ ở production)
OTP_MOCK_CODE=123456
# Khi demo nhanh không cần nhập code: đặt true → chấp nhận mọi code
OTP_MOCK_ACCEPT_ALL=true

# Zalo ZNS OTP (chỉ cần khi OTP_PROVIDER=zalo)
# ZALO_OTP_TEMPLATE_ID=     ← Template ID đã được Zalo duyệt cho OTP
# Lấy từ: Zalo Developer Console → ZNS Templates

# ── Audio Quality Gate (Lớp 2) ───────────────────────────
# Thời lượng audio tối thiểu (giây). Lý do: < 3s không thể phản hồi có ý nghĩa.
AUDIO_MIN_DURATION_SEC=3.0
# Thời lượng audio tối đa (giây). UI hiển thị 15s; 20s là biên an toàn.
AUDIO_MAX_DURATION_SEC=20.0
# SNR tối thiểu (dB). ⚠️ KHỞI ĐIỂM — cần hiệu chỉnh sau pilot thực tế.
# Tham khảo: ITU-T P.563 — "acceptable quality": SNR ≥ 10 dB.
# Môi trường quán ăn/spa VN thường nhiễu cao → thử SNR_MIN=8 trước.
SNR_MIN_THRESHOLD=8.0

# ── Semantic Validity Timeout (Lớp 3) ────────────────────
# Timeout cho Gemini validity classifier (giây). Ngắn hơn ABSA vì prompt đơn giản hơn.
SEMANTIC_CHECK_TIMEOUT_SECONDS=15

# ══════════════════════════════════════════════════════════
# MODULE 2: PDPA Compliance (web-client frontend env)
# ══════════════════════════════════════════════════════════
# Đặt trong apps/web-client/.env.local (KHÔNG commit lên GitHub)

# ── OTP bypass — Chế độ thử nghiệm ───────────────────────
# true  = bỏ qua bước nhập mã OTP (tiện cho demo/dev)
# false = bắt buộc OTP (production)
VITE_SKIP_OTP=true

# Module 3: ZNS trigger � nguong sentiment am de kich hoat ZNS
# -1.0 = rat tieu cuc, 0.0 = trung lap. Default: -0.2
# (trigger ZNS chi khi p_churn > 0.85 VA sentiment < nguong nay)
ZNS_NEG_SENTIMENT_THRESHOLD=-0.2
